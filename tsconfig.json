{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2020", // Updated to match modern module formats
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2020", // ES2020 is fine; ES2022 can also be used for newer features
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2020", // Updated for newer features
      "dom"
    ],
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true, // Catches errors in Angular DI
    "strictInputAccessModifiers": true, // Enforces stricter checks on input properties
    "strictTemplates": true, // Ensures template type safety
    "enableIvy": true // Ensures Ivy rendering is used
  }
}
